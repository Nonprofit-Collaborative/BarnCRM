<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Below_Minimum__c</fullName>
  <externalId>false</externalId>
  <formula>AND(NOT(ISBLANK(Minimum_Volunteers__c)), BLANKVALUE(Slots_Filled__c, 0) &lt; Minimum_Volunteers__c)</formula>
  <inlineHelpText>Checked while fewer places are filled than Minimum Volunteers.</inlineHelpText>
  <label>Below Minimum</label>
  <trackTrending>false</trackTrending>
  <type>Checkbox</type>
</CustomField>
