<?xml version="1.0" encoding="UTF-8" ?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
  <backgroundEndColor>#FFFFFF</backgroundEndColor>
  <backgroundFadeDirection>Diagonal</backgroundFadeDirection>
  <backgroundStartColor>#FFFFFF</backgroundStartColor>
  <chartTheme>light</chartTheme>
  <dashboardType>SpecifiedUser</dashboardType>
  <description>
    The board at a glance: the current roster, terms ending soon, attendance this year and
    disclosures still open. Giving participation is on the board's own page.
  </description>
  <leftSection>
    <columnSize>Medium</columnSize>
    <components>
      <componentType>Bar</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>Current seats by board</footer>
      <header>Current roster</header>
      <chartAxisRange>Auto</chartAxisRange>
      <legendPosition>Bottom</legendPosition>
      <sortBy>RowLabelAscending</sortBy>
      <report>BarnCRM_Corporate_Hub/Current_Board_Roster</report>
    </components>
    <components>
      <componentType>Bar</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>Invitations by person and attendance</footer>
      <header>Attendance this year</header>
      <chartAxisRange>Auto</chartAxisRange>
      <legendPosition>Bottom</legendPosition>
      <sortBy>RowLabelAscending</sortBy>
      <report>BarnCRM_Corporate_Hub/Attendance_This_Year</report>
    </components>
  </leftSection>
  <rightSection>
    <columnSize>Medium</columnSize>
    <components>
      <componentType>Table</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>Soonest first</footer>
      <header>Terms ending, next 90 days</header>
      <indicatorHighColor>#54C254</indicatorHighColor>
      <indicatorLowColor>#C25454</indicatorLowColor>
      <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
      <maxValuesDisplayed>10</maxValuesDisplayed>
      <report>BarnCRM_Corporate_Hub/Terms_Ending_Next_90_Days</report>
    </components>
    <components>
      <componentType>Table</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>Board requests still waiting, oldest due first</footer>
      <header>Open disclosures</header>
      <indicatorHighColor>#54C254</indicatorHighColor>
      <indicatorLowColor>#C25454</indicatorLowColor>
      <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
      <maxValuesDisplayed>10</maxValuesDisplayed>
      <report>BarnCRM_Corporate_Hub/Open_Board_Disclosures</report>
    </components>
  </rightSection>
  <textColor>#000000</textColor>
  <title>Board Governance</title>
  <titleColor>#000000</titleColor>
  <titleSize>12</titleSize>
</Dashboard>
