<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Data Breach: Bell When Logged</label>
    <protected>true</protected>
    <values>
        <field>Object_Name__c</field>
        <value xsi:type="xsd:string">Data_Breach__c</value>
    </values>
    <values>
        <field>Handler_Class__c</field>
        <value xsi:type="xsd:string">DataBreachHandler</value>
    </values>
    <values>
        <field>Execution_Order__c</field>
        <value xsi:type="xsd:double">10</value>
    </values>
    <values>
        <field>Enabled_By_Default__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Always_Runs__c</field>
        <value xsi:type="xsd:boolean">false</value>
    </values>
    <values>
        <field>Description__c</field>
        <value xsi:type="xsd:string">Sends the breach owner the bell reminder the moment a breach is logged, when it is open, not unlikely to be a risk and not yet reported, instead of waiting for the 6:45 AM run. The nightly run then sends no second bell for the same deadline date. Follows the Send Corporate Hub Reminders setting. Turned off, the first bell comes with the 6:45 AM run.</value>
    </values>
    <values>
        <field>Module__c</field>
        <value xsi:type="xsd:string">CorporateHub</value>
    </values>
</CustomMetadata>
