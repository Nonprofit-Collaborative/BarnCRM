<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Active_Needs_Due_Date</fullName>
  <active>true</active>
  <description>An Active obligation has a Next Due Date (R-CO2).</description>
  <errorConditionFormula>AND(ISPICKVAL(Status__c, 'Active'), ISBLANK(Due_Date__c))</errorConditionFormula>
  <errorDisplayField>Due_Date__c</errorDisplayField>
  <errorMessage>An active obligation needs a Next Due Date.</errorMessage>
</ValidationRule>
