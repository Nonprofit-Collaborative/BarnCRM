<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Quorum_Met__c</fullName>
  <externalId>false</externalId>
  <formula>AND(Voting_Count__c &gt; 0, Present_Count__c &gt;= CEILING(Voting_Count__c * BLANKVALUE(Board__r.Quorum_Percent__c, 51) / 100))</formula>
  <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
  <inlineHelpText>Checked when enough voting attendees are marked Present.</inlineHelpText>
  <label>Quorum Met</label>
  <trackTrending>false</trackTrending>
  <type>Checkbox</type>
</CustomField>
