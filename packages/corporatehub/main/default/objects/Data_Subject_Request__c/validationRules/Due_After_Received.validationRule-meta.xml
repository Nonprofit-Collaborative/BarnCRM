<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Due_After_Received</fullName>
  <active>true</active>
  <description>Due Date is on or after Received Date (R-DS1).</description>
  <errorConditionFormula>AND(NOT(ISBLANK(Due_Date__c)), NOT(ISBLANK(Received_Date__c)), Due_Date__c &lt; Received_Date__c)</errorConditionFormula>
  <errorDisplayField>Due_Date__c</errorDisplayField>
  <errorMessage>Due Date must be on or after Received Date.</errorMessage>
</ValidationRule>
