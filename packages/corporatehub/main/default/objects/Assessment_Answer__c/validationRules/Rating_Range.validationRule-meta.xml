<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Rating_Range</fullName>
  <active>true</active>
  <description>A rating is 1 to 5 (R-AA1).</description>
  <errorConditionFormula>AND(NOT(ISBLANK(Rating__c)), OR(Rating__c &lt; 1, Rating__c &gt; 5))</errorConditionFormula>
  <errorDisplayField>Rating__c</errorDisplayField>
  <errorMessage>Choose a rating from 1 to 5.</errorMessage>
</ValidationRule>
