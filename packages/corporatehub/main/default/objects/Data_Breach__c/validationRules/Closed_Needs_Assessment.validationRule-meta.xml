<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Closed_Needs_Assessment</fullName>
  <active>true</active>
  <description>A Closed breach has its risk assessed (R-DB1).</description>
  <errorConditionFormula>AND(ISPICKVAL(Status__c, 'Closed'), ISPICKVAL(Risk__c, 'Not Yet Assessed'))</errorConditionFormula>
  <errorDisplayField>Risk__c</errorDisplayField>
  <errorMessage>Assess the Risk to People before closing the breach.</errorMessage>
</ValidationRule>
