<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Term_End_After_Start</fullName>
  <active>true</active>
  <description>Term End is on or after Term Start (R-BM3).</description>
  <errorConditionFormula>AND(NOT(ISBLANK(Term_End__c)), Term_End__c &lt; Term_Start__c)</errorConditionFormula>
  <errorDisplayField>Term_End__c</errorDisplayField>
  <errorMessage>Term End must be on or after Term Start.</errorMessage>
</ValidationRule>
