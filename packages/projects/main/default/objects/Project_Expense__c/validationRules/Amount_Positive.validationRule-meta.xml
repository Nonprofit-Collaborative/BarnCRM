<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Amount_Positive</fullName>
  <active>true</active>
  <description>R-PM13: an expense is more than 0.</description>
  <errorConditionFormula>Amount__c &lt;= 0</errorConditionFormula>
  <errorDisplayField>Amount__c</errorDisplayField>
  <errorMessage>Enter an amount more than 0.</errorMessage>
</ValidationRule>
