<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Capacity_In_Range</fullName>
  <active>true</active>
  <description>R-PM14: capacity from 1 to 168 hours a week.</description>
  <errorConditionFormula>AND(NOT(ISBLANK(Weekly_Capacity_Hours__c)), OR(Weekly_Capacity_Hours__c &lt; 1, Weekly_Capacity_Hours__c &gt; 168))</errorConditionFormula>
  <errorDisplayField>Weekly_Capacity_Hours__c</errorDisplayField>
  <errorMessage>Enter from 1 to 168 hours, or leave it blank for the setting.</errorMessage>
</ValidationRule>
