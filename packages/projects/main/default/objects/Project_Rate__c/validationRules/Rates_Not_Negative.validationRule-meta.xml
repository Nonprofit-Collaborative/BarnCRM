<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Rates_Not_Negative</fullName>
  <active>true</active>
  <description>R-PM9: rates are 0 or more.</description>
  <errorConditionFormula>OR(Bill_Rate__c &lt; 0, Cost_Rate__c &lt; 0)</errorConditionFormula>
  <errorMessage>Rates cannot be negative.</errorMessage>
</ValidationRule>
