<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Rejection_Needs_Reason</fullName>
  <active>true</active>
  <description>R-PM11: a rejection says why.</description>
  <errorConditionFormula>AND(ISPICKVAL(Status__c, "Rejected"), ISBLANK(Rejection_Reason__c))</errorConditionFormula>
  <errorDisplayField>Rejection_Reason__c</errorDisplayField>
  <errorMessage>Enter a Rejection Reason.</errorMessage>
</ValidationRule>
