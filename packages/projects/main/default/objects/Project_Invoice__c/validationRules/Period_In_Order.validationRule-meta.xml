<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Period_In_Order</fullName>
  <active>true</active>
  <description>R-PM16: Period End on or after Period Start.</description>
  <errorConditionFormula>AND(NOT(ISBLANK(Period_Start__c)), NOT(ISBLANK(Period_End__c)), Period_End__c &lt; Period_Start__c)</errorConditionFormula>
  <errorDisplayField>Period_End__c</errorDisplayField>
  <errorMessage>Period End must be on or after Period Start.</errorMessage>
</ValidationRule>
