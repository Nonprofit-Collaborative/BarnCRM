/**
 * The New Commitment screen (people-giving-11), which replaces the standard New form on
 * Commitment: a pledge entered as a total and a number of payments (or a last payment date), or
 * a recurring gift entered as the amount each time. It builds the record with CommitmentEntry,
 * the same code the Ask Pipeline's Record a Pledge uses, and previews the schedule with the
 * same builder the Payment Schedule card uses.
 */
public with sharing class CommitmentEntryController {
	private static final String CONTEXT = 'CommitmentEntryController';

	/** One choice in a list. */
	public class Option {
		@AuraEnabled
		public String label;
		@AuraEnabled
		public String value;

		public Option(String label, String value) {
			this.label = label;
			this.value = value;
		}
	}

	/** What the screen starts with. */
	public class Defaults {
		@AuraEnabled
		public Boolean canCreate = false;
		@AuraEnabled
		public Boolean hasPersonAccounts = false;
		/** The donor of the page the screen was opened from, if it was a person or organization. */
		@AuraEnabled
		public String donorId;
		/** 'person' or 'organization', for the donor above. */
		@AuraEnabled
		public String donorKind;
		@AuraEnabled
		public List<Option> frequencies = new List<Option>();
		@AuraEnabled
		public String defaultFrequency;
	}

	/** What the person entered. */
	public class EntryInput {
		/** Pledge or Recurring. */
		@AuraEnabled
		public String kind { get; set; }
		@AuraEnabled
		public String donorContactId { get; set; }
		@AuraEnabled
		public String donorAccountId { get; set; }
		/** Pledge: the total promised. */
		@AuraEnabled
		public Decimal total { get; set; }
		/** Pledge: how many payments, or else the last payment date. */
		@AuraEnabled
		public Integer payments { get; set; }
		@AuraEnabled
		public Date lastPaymentDate { get; set; }
		/** Recurring: the amount each time. */
		@AuraEnabled
		public Decimal amount { get; set; }
		@AuraEnabled
		public String frequency { get; set; }
		/** The first payment date of a pledge, the start date of a recurring gift. */
		@AuraEnabled
		public Date startDate { get; set; }
		@AuraEnabled
		public String fundId { get; set; }
		@AuraEnabled
		public String appealId { get; set; }
	}

	/** What came of saving. */
	public class SaveResult {
		@AuraEnabled
		public Boolean success = false;
		@AuraEnabled
		public String error;
		@AuraEnabled
		public String commitmentId;
	}

	/** The screen's starting point, with the donor of the page it was opened from. */
	@AuraEnabled
	public static Defaults getDefaults(String contextId) {
		Defaults defaults = new Defaults();
		defaults.canCreate = Schema.SObjectType.Commitment__c.isCreateable();
		defaults.hasPersonAccounts = OrgShapeDetector.hasPersonAccounts();
		for (
			Schema.PicklistEntry entry : Commitment__c.Frequency__c.getDescribe()
				.getPicklistValues()
		) {
			if (entry.isActive()) {
				defaults.frequencies.add(new Option(entry.getLabel(), entry.getValue()));
				if (entry.isDefaultValue()) {
					defaults.defaultFrequency = entry.getValue();
				}
			}
		}
		Id context = asId(contextId);
		if (context == null) {
			return defaults;
		}
		if (context.getSObjectType() == Contact.SObjectType) {
			defaults.donorId = context;
			defaults.donorKind = 'person';
		} else if (context.getSObjectType() == Account.SObjectType) {
			defaults.donorId = context;
			defaults.donorKind = isPersonAccount(context, defaults.hasPersonAccounts)
				? 'person'
				: 'organization';
		}
		return defaults;
	}

	/**
	 * The schedule these entries would make, or null while they are not complete enough to
	 * make one. Nothing is saved.
	 */
	@AuraEnabled
	public static CommitmentController.SchedulePreview preview(EntryInput input) {
		Commitment__c draft = draftOrNull(input);
		if (draft == null) {
			return null;
		}
		CommitmentController.ScheduleInput scheduleInput = new CommitmentController.ScheduleInput();
		scheduleInput.commitmentType = draft.Type__c;
		scheduleInput.amount = draft.Amount__c;
		scheduleInput.frequency = draft.Frequency__c;
		scheduleInput.startDate = draft.Start_Date__c;
		scheduleInput.expectedTotal = draft.Expected_Total__c;
		scheduleInput.installmentsPlanned = draft.Installments_Planned__c;
		return CommitmentController.getSchedulePreview(scheduleInput);
	}

	/** Saves the commitment; its schedule is generated by the commitment triggers. */
	@AuraEnabled
	public static SaveResult save(EntryInput input) {
		SaveResult result = new SaveResult();
		if (!Schema.SObjectType.Commitment__c.isCreateable()) {
			result.error = Label.Giving_Commitment_NoPermission;
			return result;
		}
		result.error = problem(input);
		if (result.error != null) {
			return result;
		}
		try {
			Commitment__c commitment = draftOrNull(input);
			Database.insert(commitment, true, AccessLevel.USER_MODE);
			result.commitmentId = commitment.Id;
			result.success = true;
		} catch (DmlException refused) {
			result.error = refused.getDmlMessage(0);
		} catch (Exception failure) {
			ErrorLogger.log(failure, CONTEXT + '.save');
			result.error = BarnHelp.text('Giving', 'Giving_CommitmentNew_ErrorUnexpected');
		}
		return result;
	}

	/** The first thing wrong with the entries, or null. */
	private static String problem(EntryInput input) {
		if (input == null) {
			return Label.Giving_Ask_ErrorAmount;
		}
		Id contactId = asId(input.donorContactId);
		Id accountId = asId(input.donorAccountId);
		if (contactId == null && accountId == null) {
			return BarnHelp.text('Giving', 'Giving_CommitmentNew_ErrorNoDonor');
		}
		if (contactId != null && accountId != null) {
			return BarnHelp.text('Giving', 'Giving_CommitmentNew_ErrorTwoDonors');
		}
		if (isRecurring(input)) {
			return CommitmentEntry.recurringProblem(input.amount, input.frequency, input.startDate);
		}
		if (
			input.payments == null &&
			input.lastPaymentDate != null &&
			input.startDate != null &&
			input.lastPaymentDate < input.startDate
		) {
			return BarnHelp.text('Giving', 'Giving_CommitmentNew_ErrorLastDate');
		}
		return CommitmentEntry.pledgeProblem(
			input.total,
			paymentsFor(input),
			input.frequency,
			input.startDate
		);
	}

	/** The unsaved commitment the entries describe, or null while they are incomplete. */
	private static Commitment__c draftOrNull(EntryInput input) {
		if (input == null) {
			return null;
		}
		Id contactId = asId(input.donorContactId);
		Id accountId = asId(input.donorAccountId);
		Id appealId = asId(input.appealId);
		Id fundId = asId(input.fundId);
		if (isRecurring(input)) {
			if (
				CommitmentEntry.recurringProblem(input.amount, input.frequency, input.startDate) !=
				null
			) {
				return null;
			}
			return CommitmentEntry.recurring(
				contactId,
				accountId,
				input.amount,
				input.frequency,
				input.startDate,
				appealId,
				fundId
			);
		}
		Integer payments = paymentsFor(input);
		if (
			CommitmentEntry.pledgeProblem(
				input.total,
				payments,
				input.frequency,
				input.startDate
			) != null
		) {
			return null;
		}
		return CommitmentEntry.pledge(
			contactId,
			accountId,
			input.total,
			payments,
			input.frequency,
			input.startDate,
			appealId,
			fundId
		);
	}

	/** The number of payments entered, or the count up to the last payment date. */
	private static Integer paymentsFor(EntryInput input) {
		if (input.payments != null) {
			return input.payments;
		}
		return CommitmentEntry.paymentsThrough(
			input.frequency,
			input.startDate,
			input.lastPaymentDate
		);
	}

	private static Boolean isRecurring(EntryInput input) {
		return CommitmentEntry.TYPE_RECURRING.equals(input.kind);
	}

	/**
	 * True for an account that is a person, in an org that stores people as accounts: its record
	 * type is one of the person types Core detects. Only decides which picker the screen opens
	 * on; either way the donor is saved on Donor Account.
	 */
	private static Boolean isPersonAccount(Id accountId, Boolean hasPersonAccounts) {
		Set<Id> personTypes = hasPersonAccounts
			? OrgShapeDetector.personAccountRecordTypeIds()
			: new Set<Id>();
		if (personTypes.isEmpty()) {
			return false;
		}
		// Person account orgs always have Account record types, so RecordTypeId is read by name.
		List<SObject> rows = Database.queryWithBinds(
			'SELECT RecordTypeId FROM Account WHERE Id = :accountId',
			new Map<String, Object>{ 'accountId' => accountId },
			AccessLevel.USER_MODE
		);
		return !rows.isEmpty() && personTypes.contains((Id) rows[0].get('RecordTypeId'));
	}

	private static Id asId(String value) {
		if (String.isBlank(value)) {
			return null;
		}
		try {
			return Id.valueOf(value);
		} catch (Exception notAnId) {
			return null;
		}
	}
}
