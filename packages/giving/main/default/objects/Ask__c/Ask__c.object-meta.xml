<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
  <compactLayoutAssignment>Ask_Compact</compactLayoutAssignment>
  <deploymentStatus>Deployed</deploymentStatus>
  <description>
    One request for a gift a fundraiser is working toward: the donor, the stage, the ask amount,
    the target date, who is responsible, and how it ended. The Giving module's own solicitation
    pipeline (canonical model Section 25O).
  </description>
  <enableActivities>true</enableActivities>
  <enableBulkApi>true</enableBulkApi>
  <enableFeeds>false</enableFeeds>
  <enableHistory>true</enableHistory>
  <enableReports>true</enableReports>
  <enableSearch>true</enableSearch>
  <enableSharing>true</enableSharing>
  <enableStreamingApi>true</enableStreamingApi>
  <label>Ask</label>
  <nameField>
    <displayFormat>ASK-{00000000}</displayFormat>
    <label>Ask Number</label>
    <trackHistory>false</trackHistory>
    <type>AutoNumber</type>
  </nameField>
  <pluralLabel>Asks</pluralLabel>
  <sharingModel>ReadWrite</sharingModel>
  <visibility>Public</visibility>
</CustomObject>
