<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Amount_Above_Zero</fullName>
  <active>true</active>
  <description>R-FE1: an amount is above zero.</description>
  <errorConditionFormula>Amount__c &lt;= 0</errorConditionFormula>
  <errorDisplayField>Amount__c</errorDisplayField>
  <errorMessage>An entry's amount must be above zero.</errorMessage>
</ValidationRule>
