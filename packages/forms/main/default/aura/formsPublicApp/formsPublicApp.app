<aura:application access="GLOBAL" extends="ltng:outApp" implements="ltng:allowGuestAccess">
  <!-- Lightning Out app for public forms on a Salesforce Site (C-42b) and modules' public pages (EV-16): the components it carries. -->
  <aura:dependency resource="c:formPublic" />
  <aura:dependency resource="c:formPublicPage" />
</aura:application>
