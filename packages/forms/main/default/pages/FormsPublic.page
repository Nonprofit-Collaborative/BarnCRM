<apex:page
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  applyBodyTag="true"
  docType="html-5.0"
  title="Form"
>
  <!--
    The public form page for a Salesforce Site (C-42b; ADR-0184 public forms on a Salesforce
    Site, decision 10): <site URL>/FormsPublic?form=<form id>, with &record=<id> for a form a
    module attached to a record, or &resume=<token> from a save-for-later email (C-42c). With
    record=<id> and no form, a module's public page for that record, such as an event, with its
    form; with list=<kind>, a module's public list, such as list=events (EV-16; ADR-0190 public
    event pages, decision 7). It only hosts c:formPublic or c:formPublicPage through Lightning
    Out; FormPublicController decides everything on the server.
  -->
  <apex:includeLightning />
  <div id="barn-form"></div>
  <script>
    (function () {
      var formId = '{!JSENCODE($CurrentPage.parameters.form)}';
      var recordId = '{!JSENCODE($CurrentPage.parameters.record)}';
      var listKind = '{!JSENCODE($CurrentPage.parameters.list)}';
      var isPage = !formId && (recordId || listKind);
      $Lightning.use('c:formsPublicApp', function () {
        $Lightning.createComponent(
          isPage ? 'c:formPublicPage' : 'c:formPublic',
          isPage
            ? { recordId: recordId, listKind: listKind }
            : {
                formId: formId,
                recordId: recordId,
                resumeToken: '{!JSENCODE($CurrentPage.parameters.resume)}'
              },
          'barn-form'
        );
      });
    })();
  </script>
</apex:page>
