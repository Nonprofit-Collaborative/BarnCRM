<apex:page
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  applyBodyTag="true"
  docType="html-5.0"
  title="Form"
>
  <!--
    The public form page for a Salesforce Site (C-42b; ADR-NEXT public forms on a Salesforce
    Site, decision 10): <site URL>/FormsPublic?form=<form id>, with &record=<id> for a form a
    module attached to a record. It only hosts c:formPublic through Lightning Out;
    FormPublicController decides everything on the server.
  -->
  <apex:includeLightning />
  <div id="barn-form"></div>
  <script>
    $Lightning.use('c:formsPublicApp', function () {
      $Lightning.createComponent(
        'c:formPublic',
        {
          formId: '{!JSENCODE($CurrentPage.parameters.form)}',
          recordId: '{!JSENCODE($CurrentPage.parameters.record)}'
        },
        'barn-form'
      );
    });
  </script>
</apex:page>
