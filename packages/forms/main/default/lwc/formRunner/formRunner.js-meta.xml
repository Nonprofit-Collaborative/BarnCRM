<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67.0</apiVersion>
  <description>
    Fills in a published form a step at a time and sends the answers. On a record page it fills
    in the form a module attached to the record, or one the person picks.
  </description>
  <isExposed>true</isExposed>
  <masterLabel>Form Runner</masterLabel>
  <targets>
    <target>lightning__RecordPage</target>
    <target>lightning__AppPage</target>
    <target>lightning__HomePage</target>
    <target>lightning__Tab</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightning__AppPage,lightning__HomePage">
      <property name="formId" type="String" label="Form Record Id" />
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>
