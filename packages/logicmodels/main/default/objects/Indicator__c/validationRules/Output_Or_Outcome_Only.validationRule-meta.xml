<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Output_Or_Outcome_Only</fullName>
  <active>true</active>
  <description>
    R-IN1: indicators belong to outputs and outcomes only.
  </description>
  <errorConditionFormula>
AND(
  NOT(ISPICKVAL(Element__r.Type__c, &quot;Output&quot;)),
  NOT(ISPICKVAL(Element__r.Type__c, &quot;Outcome&quot;))
)
  </errorConditionFormula>
  <errorMessage>
    Indicators belong to outputs and outcomes only.
  </errorMessage>
</ValidationRule>
