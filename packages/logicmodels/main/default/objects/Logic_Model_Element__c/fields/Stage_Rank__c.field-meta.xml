<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Stage_Rank__c</fullName>
  <description>R-LL2: arrows go up the ranks. The builder's logicModelRules module holds the same table.</description>
  <externalId>false</externalId>
  <formula>CASE(TEXT(Type__c), &quot;Input&quot;, 1, &quot;Activity&quot;, 2, &quot;Output&quot;, 3, &quot;Outcome&quot;,
CASE(TEXT(Outcome_Term__c), &quot;Intermediate Term&quot;, 5, &quot;Long Term&quot;, 6, 4), &quot;Impact&quot;, 7, 0)</formula>
  <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
  <inlineHelpText>Its stage, from Input 1 to Impact 7. Arrows only go to a higher stage.</inlineHelpText>
  <label>Stage Rank</label>
  <precision>18</precision>
  <required>false</required>
  <scale>0</scale>
  <trackTrending>false</trackTrending>
  <type>Number</type>
  <unique>false</unique>
</CustomField>
