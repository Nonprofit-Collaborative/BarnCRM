<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <label>Check rollups before saving</label>
  <protected>true</protected>
  <values>
    <field>Description__c</field>
    <value xsi:type="xsd:string">Checks that the field a rollup fills can hold its calculation: a checkbox for Any and None, a text field for a text list, a number for Count distinct. It always runs, also while BarnCRM Rollup Builder is turned off, so a rollup saved then is checked as well.</value>
  </values>
  <values>
    <field>Always_Runs__c</field>
    <value xsi:type="xsd:boolean">true</value>
  </values>
  <values>
    <field>Enabled_By_Default__c</field>
    <value xsi:type="xsd:boolean">true</value>
  </values>
  <values>
    <field>Handler_Class__c</field>
    <value xsi:type="xsd:string">RollupDefinitionValidationHandler</value>
  </values>
  <values>
    <field>Object_Name__c</field>
    <value xsi:type="xsd:string">Rollup_Definition__c</value>
  </values>
  <values>
    <field>Execution_Order__c</field>
    <value xsi:type="xsd:double">10</value>
  </values>
  <values>
    <field>Module__c</field>
    <value xsi:type="xsd:string">Rollups</value>
  </values>
</CustomMetadata>
