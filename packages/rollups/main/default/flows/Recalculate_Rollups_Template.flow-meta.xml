<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <actionCalls>
    <description>Keeps every BarnCRM rollup that counts this record up to date.</description>
    <name>Recalculate_rollups</name>
    <label>Recalculate rollups</label>
    <locationX>176</locationX>
    <locationY>323</locationY>
    <actionName>RollupRecalcAction</actionName>
    <actionType>apex</actionType>
    <dataTypeMappings>
      <typeName>T__priorRecord</typeName>
      <typeValue>Contact</typeValue>
    </dataTypeMappings>
    <dataTypeMappings>
      <typeName>T__record</typeName>
      <typeValue>Contact</typeValue>
    </dataTypeMappings>
    <faultConnector>
      <targetReference>Note_The_Fault</targetReference>
    </faultConnector>
    <flowTransactionModel>CurrentTransaction</flowTransactionModel>
    <inputParameters>
      <name>priorRecord</name>
      <value>
        <elementReference>$Record__Prior</elementReference>
      </value>
    </inputParameters>
    <inputParameters>
      <name>record</name>
      <value>
        <elementReference>$Record</elementReference>
      </value>
    </inputParameters>
    <nameSegment>RollupRecalcAction</nameSegment>
    <storeOutputAutomatically>true</storeOutputAutomatically>
    <versionSegment>1</versionSegment>
  </actionCalls>
  <apiVersion>67.0</apiVersion>
  <assignments>
    <description>A fault never fails the save, as for every rollup: the action logs its own errors to the BarnCRM Error Log, and the nightly run in Both mode puts the total right. The message is kept here for the flow's debug log.</description>
    <name>Note_The_Fault</name>
    <label>Note the fault</label>
    <locationX>440</locationX>
    <locationY>431</locationY>
    <assignmentItems>
      <assignToReference>varFaultMessage</assignToReference>
      <operator>Assign</operator>
      <value>
        <elementReference>$Flow.FaultMessage</elementReference>
      </value>
    </assignmentItems>
  </assignments>
  <description>
    Template: makes BarnCRM rollups that count one of your own objects instant. Save As a new
    flow, change the object in the Start element and in the Recalculate rollups action to your
    object, then activate your copy. See the Rollups page of the admin guide.
  </description>
  <environments>Default</environments>
  <interviewLabel>Recalculate rollups {!$Flow.CurrentDateTime}</interviewLabel>
  <isTemplate>true</isTemplate>
  <label>Recalculate rollups (template)</label>
  <processMetadataValues>
    <name>BuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processMetadataValues>
    <name>CanvasMode</name>
    <value>
      <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
    </value>
  </processMetadataValues>
  <processMetadataValues>
    <name>OriginBuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processType>AutoLaunchedFlow</processType>
  <start>
    <locationX>50</locationX>
    <locationY>0</locationY>
    <connector>
      <targetReference>Recalculate_rollups</targetReference>
    </connector>
    <filterFormula>NOT(ISBLANK({!$Record.Id}))</filterFormula>
    <object>Contact</object>
    <recordTriggerType>CreateAndUpdate</recordTriggerType>
    <triggerType>RecordAfterSave</triggerType>
  </start>
  <status>Draft</status>
  <variables>
    <description>Why the Recalculate rollups action faulted, for the flow's debug log.</description>
    <name>varFaultMessage</name>
    <dataType>String</dataType>
    <isCollection>false</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
  </variables>
</Flow>
