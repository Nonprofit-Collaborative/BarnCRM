<?xml version="1.0" encoding="UTF-8" ?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
  <backgroundEndColor>#FFFFFF</backgroundEndColor>
  <backgroundFadeDirection>Diagonal</backgroundFadeDirection>
  <backgroundStartColor>#FFFFFF</backgroundStartColor>
  <chartTheme>light</chartTheme>
  <dashboardType>SpecifiedUser</dashboardType>
  <description>
    Where applications stand in each cycle, how much each program has awarded and paid, which
    applications score highest, which disbursements are due, and which recipient reports are owed.
  </description>
  <leftSection>
    <columnSize>Medium</columnSize>
    <components>
      <chartAxisRange>Auto</chartAxisRange>
      <componentType>BarStacked</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>Every application, by its current status</footer>
      <header>Applications by Cycle and Status</header>
      <legendPosition>Bottom</legendPosition>
      <report>BarnCRM_Scholarships/Applications_by_Cycle_and_Status</report>
      <sortBy>RowLabelAscending</sortBy>
    </components>
    <components>
      <chartAxisRange>Auto</chartAxisRange>
      <componentType>Bar</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>Offered, Accepted, Active and Completed awards</footer>
      <header>Awarded by Program</header>
      <legendPosition>Bottom</legendPosition>
      <report>BarnCRM_Scholarships/Awards_by_Program</report>
      <sortBy>RowValueDescending</sortBy>
    </components>
    <components>
      <componentType>Table</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>Submitted, Eligible and In Review, highest score first</footer>
      <header>Top-Scoring Applications</header>
      <indicatorHighColor>#54C254</indicatorHighColor>
      <indicatorLowColor>#C25454</indicatorLowColor>
      <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
      <maxValuesDisplayed>10</maxValuesDisplayed>
      <report>BarnCRM_Scholarships/Applications_Ranked_by_Score</report>
    </components>
  </leftSection>
  <rightSection>
    <columnSize>Medium</columnSize>
    <components>
      <componentType>Table</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>Scheduled disbursements, soonest first; records only</footer>
      <header>Disbursements Due, Next 30 Days</header>
      <indicatorHighColor>#54C254</indicatorHighColor>
      <indicatorLowColor>#C25454</indicatorLowColor>
      <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
      <maxValuesDisplayed>10</maxValuesDisplayed>
      <report>BarnCRM_Scholarships/Disbursements_Due_Next_30_Days</report>
    </components>
    <components>
      <componentType>Table</componentType>
      <drillEnabled>true</drillEnabled>
      <footer>Open progress and final reports, overdue first</footer>
      <header>Recipient Reports Due</header>
      <indicatorHighColor>#54C254</indicatorHighColor>
      <indicatorLowColor>#C25454</indicatorLowColor>
      <indicatorMiddleColor>#C2C254</indicatorMiddleColor>
      <maxValuesDisplayed>10</maxValuesDisplayed>
      <report>BarnCRM_Scholarships/Recipient_Reports_Due</report>
    </components>
  </rightSection>
  <textColor>#000000</textColor>
  <title>Scholarships and Grants</title>
  <titleColor>#000000</titleColor>
  <titleSize>12</titleSize>
</Dashboard>
