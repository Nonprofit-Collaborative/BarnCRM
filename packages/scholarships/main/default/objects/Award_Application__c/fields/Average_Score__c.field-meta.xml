<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Average_Score__c</fullName>
  <formula>IF(Review_Count__c = 0, NULL, Total_Score__c / Review_Count__c)</formula>
  <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
  <inlineHelpText>The submitted scores divided by the number of reviews. Empty before the first.</inlineHelpText>
  <label>Average Score</label>
  <precision>18</precision>
  <scale>2</scale>
  <trackTrending>false</trackTrending>
  <type>Number</type>
</CustomField>
