<?xml version="1.0" encoding="UTF-8" ?>
<!-- The org's own Google API key with the Address Validation API enabled (canonical model R-AV4). An administrator adds the authentication parameter ApiKey to the principal Barn_Google_Address_Key in Setup; Address Verification's Apex merges it into the X-Goog-Api-Key header and never reads it. No value is shipped. -->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
  <authenticationProtocol>Custom</authenticationProtocol>
  <externalCredentialParameters>
    <parameterGroup>Barn_Google_Address_Key</parameterGroup>
    <parameterName>Barn_Google_Address_Key</parameterName>
    <parameterType>NamedPrincipal</parameterType>
    <sequenceNumber>1</sequenceNumber>
  </externalCredentialParameters>
  <label>BarnCRM Google Address Validation</label>
</ExternalCredential>
