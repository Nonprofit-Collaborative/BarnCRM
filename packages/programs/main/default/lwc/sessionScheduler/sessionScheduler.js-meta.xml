<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67.0</apiVersion>
  <description>
    Schedule sessions of a service for a cohort, or for a program's participants: one session on
    each chosen weekday between two dates, at most 200 at a time.
  </description>
  <isExposed>true</isExposed>
  <masterLabel>Schedule Sessions</masterLabel>
  <targets>
    <target>lightning__RecordPage</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightning__RecordPage">
      <objects>
        <object>Cohort__c</object>
        <object>Program__c</object>
      </objects>
      <supportedFormFactors>
        <supportedFormFactor type="Large" />
        <supportedFormFactor type="Small" />
      </supportedFormFactors>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>
