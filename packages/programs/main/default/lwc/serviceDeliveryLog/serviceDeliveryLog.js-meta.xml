<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67.0</apiVersion>
  <description>
    Attendance and services for a program: pick a service and a day, record each enrolled person's
    attendance and quantity, and save them in one go. Works the same on a phone.
  </description>
  <isExposed>true</isExposed>
  <masterLabel>Service Delivery Log</masterLabel>
  <targets>
    <target>lightning__RecordPage</target>
  </targets>
  <targetConfigs>
    <targetConfig targets="lightning__RecordPage">
      <objects>
        <object>Program__c</object>
      </objects>
      <supportedFormFactors>
        <supportedFormFactor type="Large" />
        <supportedFormFactor type="Small" />
      </supportedFormFactors>
    </targetConfig>
  </targetConfigs>
</LightningComponentBundle>
