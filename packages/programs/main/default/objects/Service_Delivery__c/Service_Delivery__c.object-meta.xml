<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
  <compactLayoutAssignment>Service_Delivery_Compact</compactLayoutAssignment>
  <deploymentStatus>Deployed</deploymentStatus>
  <description>
    One service given to one person on one day, or their absence from it: attendance and
    service delivery in one record. A lookup to its service, not a detail, so participant
    privacy can be set apart from the program (canonical model Section 29ZB).
  </description>
  <enableActivities>true</enableActivities>
  <enableBulkApi>true</enableBulkApi>
  <enableFeeds>false</enableFeeds>
  <enableHistory>false</enableHistory>
  <enableReports>true</enableReports>
  <enableSearch>true</enableSearch>
  <enableSharing>true</enableSharing>
  <enableStreamingApi>true</enableStreamingApi>
  <externalSharingModel>Private</externalSharingModel>
  <label>Service Delivery</label>
  <nameField>
    <displayFormat>SD-{000000}</displayFormat>
    <label>Service Delivery Number</label>
    <trackHistory>false</trackHistory>
    <type>AutoNumber</type>
  </nameField>
  <pluralLabel>Service Deliveries</pluralLabel>
  <sharingModel>Private</sharingModel>
  <visibility>Public</visibility>
</CustomObject>
