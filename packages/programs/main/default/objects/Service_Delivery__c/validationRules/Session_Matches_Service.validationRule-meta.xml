<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Session_Matches_Service</fullName>
  <active>true</active>
  <description>
    R-SD7: a delivery's session is a session of the delivery's service.
  </description>
  <errorConditionFormula>
AND(
  NOT(ISBLANK(Session__c)),
  Session__r.Service__c &lt;&gt; Service__c
)
  </errorConditionFormula>
  <errorDisplayField>Session__c</errorDisplayField>
  <errorMessage>
    Choose a session of this service.
  </errorMessage>
</ValidationRule>
