<?xml version="1.0" encoding="UTF-8" ?>
<!-- The org's own PayPal REST app (canonical model R-PK1). An administrator adds the authentication parameters ClientId and ClientSecret to the principal Barn_PayPal_App in Setup; Payments' Apex merges them into the sign-in call's Basic header and never reads them. Serves both Barn_PayPal_Live and Barn_PayPal_Sandbox. No value is shipped. -->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
  <authenticationProtocol>Custom</authenticationProtocol>
  <externalCredentialParameters>
    <parameterGroup>Barn_PayPal_App</parameterGroup>
    <parameterName>Barn_PayPal_App</parameterName>
    <parameterType>NamedPrincipal</parameterType>
    <sequenceNumber>1</sequenceNumber>
  </externalCredentialParameters>
  <label>BarnCRM PayPal</label>
</ExternalCredential>
