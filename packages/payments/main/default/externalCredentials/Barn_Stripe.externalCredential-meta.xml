<?xml version="1.0" encoding="UTF-8" ?>
<!-- The org's own Stripe secret key (canonical model R-PK1). An administrator adds the authentication parameter SecretKey to the principal Barn_Stripe_Key in Setup; Payments' Apex merges it into the Authorization header and never reads it. No value is shipped. -->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
  <authenticationProtocol>Custom</authenticationProtocol>
  <externalCredentialParameters>
    <parameterGroup>Barn_Stripe_Key</parameterGroup>
    <parameterName>Barn_Stripe_Key</parameterName>
    <parameterType>NamedPrincipal</parameterType>
    <sequenceNumber>1</sequenceNumber>
  </externalCredentialParameters>
  <label>BarnCRM Stripe</label>
</ExternalCredential>
