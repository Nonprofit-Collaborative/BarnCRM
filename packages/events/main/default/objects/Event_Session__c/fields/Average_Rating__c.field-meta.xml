<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Average_Rating__c</fullName>
  <inlineHelpText>The ratings added together and divided by how many there are, from 1 to 5. Empty before the first rating.</inlineHelpText>
  <label>Average Rating</label>
  <trackTrending>false</trackTrending>
  <formula>IF(Rating_Count__c = 0, NULL, Rating_Total__c / Rating_Count__c)</formula>
  <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
  <precision>18</precision>
  <scale>1</scale>
  <type>Number</type>
</CustomField>
