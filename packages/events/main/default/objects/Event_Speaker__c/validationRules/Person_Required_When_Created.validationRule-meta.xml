<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Person_Required_When_Created</fullName>
  <active>true</active>
  <description>R-ESP1: a new speaker names a Core person. A person deleted later leaves the speaker with none.</description>
  <errorConditionFormula>ISNEW() &amp;&amp; ISBLANK(Contact__c)</errorConditionFormula>
  <errorDisplayField>Contact__c</errorDisplayField>
  <errorMessage>Choose the person who speaks.</errorMessage>
</ValidationRule>
