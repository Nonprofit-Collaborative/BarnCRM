<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Sales_End_After_Start</fullName>
  <active>true</active>
  <description>R-TT3: sales end after they start, when both are set.</description>
  <errorConditionFormula>
AND(
  NOT(ISBLANK(Sales_Start__c)),
  NOT(ISBLANK(Sales_End__c)),
  Sales_End__c &lt;= Sales_Start__c
)
  </errorConditionFormula>
  <errorDisplayField>Sales_End__c</errorDisplayField>
  <errorMessage>Sales End must be after Sales Start.</errorMessage>
</ValidationRule>
