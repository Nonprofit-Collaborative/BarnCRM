<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Applicant_Required_When_Created</fullName>
  <active>true</active>
  <description>R-SA1: a new application names a Core person. A person deleted later leaves the application with none.</description>
  <errorConditionFormula>ISNEW() &amp;&amp; ISBLANK(Contact__c)</errorConditionFormula>
  <errorDisplayField>Contact__c</errorDisplayField>
  <errorMessage>Choose the person who applied.</errorMessage>
</ValidationRule>
