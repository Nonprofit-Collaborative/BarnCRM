<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
  <hasActivationRequired>false</hasActivationRequired>
  <label>Contact Point Sync Admin</label>
  <description>
    Opens the Contact Point Sync page, previews and starts the backfill, and reads which Contact
    Points BarnCRM manages. Starting the backfill also needs the Manage BarnCRM Settings
    permission.
  </description>
  <classAccesses>
    <apexClass>ContactPointSyncController</apexClass>
    <enabled>true</enabled>
  </classAccesses>
  <fieldPermissions>
    <editable>false</editable>
    <field>Contact_Point_Link__c.Contact_Point_Id__c</field>
    <readable>true</readable>
  </fieldPermissions>
  <objectPermissions>
    <allowCreate>false</allowCreate>
    <allowDelete>false</allowDelete>
    <allowEdit>false</allowEdit>
    <allowRead>true</allowRead>
    <modifyAllRecords>false</modifyAllRecords>
    <object>Contact</object>
    <viewAllRecords>false</viewAllRecords>
  </objectPermissions>
  <objectPermissions>
    <allowCreate>false</allowCreate>
    <allowDelete>false</allowDelete>
    <allowEdit>false</allowEdit>
    <allowRead>true</allowRead>
    <modifyAllRecords>false</modifyAllRecords>
    <object>Contact_Point_Link__c</object>
    <viewAllRecords>false</viewAllRecords>
  </objectPermissions>
  <tabSettings>
    <tab>Contact_Point_Sync</tab>
    <visibility>Visible</visibility>
  </tabSettings>
</PermissionSet>
