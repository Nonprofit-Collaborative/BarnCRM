<?xml version="1.0" encoding="UTF-8" ?>
<!-- The org's own Metadata API connection (C-49d; the S15 design of ADR-0082 A2). Custom protocol, one named principal, no secret: the Named Credential is created in the org by Set Up Connection, and the queued job sends its own session in the SOAP header. -->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
  <authenticationProtocol>Custom</authenticationProtocol>
  <externalCredentialParameters>
    <parameterGroup>Principal</parameterGroup>
    <parameterName>Principal</parameterName>
    <parameterType>NamedPrincipal</parameterType>
    <sequenceNumber>1</sequenceNumber>
  </externalCredentialParameters>
  <label>BarnCRM: this org</label>
</ExternalCredential>
