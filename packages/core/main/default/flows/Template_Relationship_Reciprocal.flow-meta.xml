      <conditions>
        <leftValueReference>$Record.End_Date__c</leftValueReference>
        <operator>NotEqualTo</operator>
        <rightValue>
          <elementReference>$Record__Prior.End_Date__c</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>$Record.Description__c</leftValueReference>
        <operator>NotEqualTo</operator>
        <rightValue>
          <elementReference>$Record__Prior.Description__c</elementReference>
        </rightValue>
      </conditions>
      <conditions>
