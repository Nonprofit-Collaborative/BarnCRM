  <decisions>
    <description>Gone: the other side was deleted, so a new one is made. In step: the other side already says what this one would write, which is what a write from the other side looks like when it arrives here, so nothing is written back.</description>
    <name>Other_Side_State</name>
    <label>Other side state</label>
    <locationX>182</locationX>
    <locationY>755</locationY>
    <defaultConnector>
      <targetReference>Update_Other_Side</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Out of step</defaultConnectorLabel>
    <rules>
      <name>Gone</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>Get_Other_Side</leftValueReference>
        <operator>IsNull</operator>
        <rightValue>
          <booleanValue>true</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Find_Unpaired</targetReference>
      </connector>
      <label>Gone</label>
    </rules>
    <rules>
      <name>In_Step</name>
      <conditionLogic>1 AND 2 AND 3 AND 4 AND 5 AND 6 AND 7 AND 8 AND (9 OR 10 OR 11)</conditionLogic>
      <conditions>
        <leftValueReference>Get_Other_Side.Contact__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>$Record.Related_Contact__c</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>Get_Other_Side.Person_Account__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>$Record.Related_Person_Account__c</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>Get_Other_Side.Related_Contact__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>$Record.Contact__c</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>Get_Other_Side.Related_Person_Account__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>$Record.Person_Account__c</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>Get_Other_Side.Status__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>fMirrorStatus</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>Get_Other_Side.Start_Date__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>$Record.Start_Date__c</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>Get_Other_Side.End_Date__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>$Record.End_Date__c</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>Get_Other_Side.Description__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>$Record.Description__c</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>Get_Other_Side.Type__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>fReciprocalType</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>$Record.Type__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>Get_Other_Side.Reciprocal_Type__c</elementReference>
        </rightValue>
      </conditions>
      <conditions>
        <leftValueReference>$Record.Reciprocal_Type__c</leftValueReference>
        <operator>EqualTo</operator>
        <rightValue>
          <elementReference>Get_Other_Side.Type__c</elementReference>
        </rightValue>
      </conditions>
      <label>In step</label>
    </rules>
  </decisions>
  <decisions>
