<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67.0</apiVersion>
  <decisions>
    <description>The Primary Affiliation field lives on the contact or on the person account, whichever holds this person.</description>
    <name>Person_Held_As</name>
    <label>Person held as</label>
    <locationX>176</locationX>
    <locationY>431</locationY>
    <defaultConnector>
      <targetReference>Update_Person_Account</targetReference>
    </defaultConnector>
    <defaultConnectorLabel>Account</defaultConnectorLabel>
    <rules>
      <name>Held_As_Contact</name>
      <conditionLogic>and</conditionLogic>
      <conditions>
        <leftValueReference>$Record.Contact__c</leftValueReference>
        <operator>IsNull</operator>
        <rightValue>
          <booleanValue>false</booleanValue>
        </rightValue>
      </conditions>
      <connector>
        <targetReference>Update_Contact</targetReference>
      </connector>
      <label>Contact</label>
    </rules>
  </decisions>
  <description
  >Template for the delete half of the automation "Keep one primary affiliation per person" (registry row Affiliation_Primary). Copy it together with the save template. When a primary affiliation is deleted, the person's Primary Affiliation field moves to their newest remaining current primary affiliation, or is emptied when there is none. Your copy does not read our switch or the pause: activating it is its switch. See the admin guide page flow-templates.md.</description>
  <environments>Default</environments>
  <formulas>
    <description>The person this affiliation is for, whether held as a contact or as an account.</description>
    <name>fPersonId</name>
    <dataType>String</dataType>
    <expression>BLANKVALUE({!$Record.Contact__c}, {!$Record.Person_Account__c})</expression>
  </formulas>
  <interviewLabel>BarnCRM template: Keep one primary affiliation per person (delete) {!$Flow.CurrentDateTime}</interviewLabel>
  <isTemplate>true</isTemplate>
  <label>BarnCRM template: Keep one primary affiliation per person (delete)</label>
  <processMetadataValues>
    <name>BuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processMetadataValues>
    <name>CanvasMode</name>
    <value>
      <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
    </value>
  </processMetadataValues>
  <processMetadataValues>
    <name>OriginBuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processType>AutoLaunchedFlow</processType>
  <recordLookups>
    <description>The person's newest current primary affiliation other than the one being deleted.</description>
    <name>Get_Next_Primary</name>
    <label>Get next primary</label>
    <locationX>176</locationX>
    <locationY>323</locationY>
    <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
    <connector>
      <targetReference>Person_Held_As</targetReference>
    </connector>
    <filterLogic>(1 OR 2) AND 3 AND 4 AND 5</filterLogic>
    <filters>
      <field>Contact__c</field>
      <operator>EqualTo</operator>
      <value>
        <elementReference>fPersonId</elementReference>
      </value>
    </filters>
    <filters>
      <field>Person_Account__c</field>
      <operator>EqualTo</operator>
      <value>
        <elementReference>fPersonId</elementReference>
      </value>
    </filters>
    <filters>
      <field>Is_Primary__c</field>
      <operator>EqualTo</operator>
      <value>
        <booleanValue>true</booleanValue>
      </value>
    </filters>
    <filters>
      <field>Status__c</field>
      <operator>NotEqualTo</operator>
      <value>
        <stringValue>Former</stringValue>
      </value>
    </filters>
    <filters>
      <field>Id</field>
      <operator>NotEqualTo</operator>
      <value>
        <elementReference>$Record.Id</elementReference>
      </value>
    </filters>
    <getFirstRecordOnly>true</getFirstRecordOnly>
    <object>Affiliation__c</object>
    <outputAssignments>
      <assignToReference>varPrimaryOrganization</assignToReference>
      <field>Organization__c</field>
    </outputAssignments>
    <sortField>CreatedDate</sortField>
    <sortOrder>Desc</sortOrder>
  </recordLookups>
  <recordUpdates>
    <description>Copies the remaining primary organization, or nothing, to the contact.</description>
    <name>Update_Contact</name>
    <label>Update contact</label>
    <locationX>50</locationX>
    <locationY>539</locationY>
    <filterLogic>and</filterLogic>
    <filters>
      <field>Id</field>
      <operator>EqualTo</operator>
      <value>
        <elementReference>$Record.Contact__c</elementReference>
      </value>
    </filters>
    <inputAssignments>
      <field>Primary_Affiliation__c</field>
      <value>
        <elementReference>varPrimaryOrganization</elementReference>
      </value>
    </inputAssignments>
    <object>Contact</object>
  </recordUpdates>
  <recordUpdates>
    <description>Copies the remaining primary organization, or nothing, to the person held as an account.</description>
    <name>Update_Person_Account</name>
    <label>Update person account</label>
    <locationX>314</locationX>
    <locationY>539</locationY>
    <filterLogic>and</filterLogic>
    <filters>
      <field>Id</field>
      <operator>EqualTo</operator>
      <value>
        <elementReference>$Record.Person_Account__c</elementReference>
      </value>
    </filters>
    <inputAssignments>
      <field>Primary_Affiliation__c</field>
      <value>
        <elementReference>varPrimaryOrganization</elementReference>
      </value>
    </inputAssignments>
    <object>Account</object>
  </recordUpdates>
  <start>
    <locationX>50</locationX>
    <locationY>0</locationY>
    <connector>
      <targetReference>Get_Next_Primary</targetReference>
    </connector>
    <filterFormula>AND({!$Record.Is_Primary__c}, NOT(AND(ISBLANK({!$Record.Contact__c}), ISBLANK({!$Record.Person_Account__c}))))</filterFormula>
    <object>Affiliation__c</object>
    <recordTriggerType>Delete</recordTriggerType>
    <triggerType>RecordBeforeDelete</triggerType>
  </start>
  <status>Draft</status>
  <variables>
    <description>The organization of the person's remaining primary affiliation, or empty when there is none.</description>
    <name>varPrimaryOrganization</name>
    <dataType>String</dataType>
    <isCollection>false</isCollection>
    <isInput>false</isInput>
    <isOutput>false</isOutput>
  </variables>
</Flow>
