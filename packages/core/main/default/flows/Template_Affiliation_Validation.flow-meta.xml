<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67.0</apiVersion>
  <assignments>
    <description>Settles the status against the dates: an end date means Former, clearing an end date means Current, and an empty status means Current. A former affiliation is never primary.</description>
    <name>Settle_Status</name>
    <label>Settle status</label>
    <locationX>176</locationX>
    <locationY>323</locationY>
    <assignmentItems>
      <assignToReference>$Record.Status__c</assignToReference>
      <operator>Assign</operator>
      <value>
        <elementReference>fStatus</elementReference>
      </value>
    </assignmentItems>
    <assignmentItems>
      <assignToReference>$Record.Is_Primary__c</assignToReference>
      <operator>Assign</operator>
      <value>
        <elementReference>fIsPrimary</elementReference>
      </value>
    </assignmentItems>
    <connector>
      <targetReference>Check_People</targetReference>
    </connector>
  </assignments>
  <assignments>
    <description>Remembers the affiliation already on file that covers the same dates, so the message can name it.</description>
