    <locationX>264</locationX>
    <locationY>1055</locationY>
    <assignmentItems>
      <assignToReference>varClashName</assignToReference>
      <operator>Assign</operator>
      <value>
        <elementReference>Each_Same_Organization.Name</elementReference>
      </value>
    </assignmentItems>
    <connector>
      <targetReference>Each_Same_Organization</targetReference>
    </connector>
  </assignments>
