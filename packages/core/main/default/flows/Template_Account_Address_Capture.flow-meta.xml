<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
  <apiVersion>67.0</apiVersion>
  <description
  >Template for the automation "Keep the address an account started with" (registry row Account_Address_Capture). Save As a new flow, change your copy, activate it, then switch ours off on the Automation page of BarnCRM Settings. When a household or an organization is created with an address in its billing fields, keeps that address on file as its first address, marked primary. Your copy does not read our switch or the pause: activating it is its switch. See the admin guide page flow-templates.md.</description>
  <environments>Default</environments>
  <formulas>
    <description>Home for a household, Work for an organization, the same types BarnCRM gives a first address.</description>
    <name>fAddressType</name>
    <dataType>String</dataType>
    <expression>IF({!$Record.Is_Organization__c}, "Work", "Home")</expression>
  </formulas>
  <interviewLabel>BarnCRM template: Keep the address an account started with {!$Flow.CurrentDateTime}</interviewLabel>
  <isTemplate>true</isTemplate>
  <label>BarnCRM template: Keep the address an account started with</label>
  <processMetadataValues>
    <name>BuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processMetadataValues>
    <name>CanvasMode</name>
    <value>
      <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
    </value>
  </processMetadataValues>
  <processMetadataValues>
    <name>OriginBuilderType</name>
    <value>
      <stringValue>LightningFlowBuilder</stringValue>
    </value>
  </processMetadataValues>
  <processType>AutoLaunchedFlow</processType>
  <recordCreates>
    <description>Creates the first address from the billing fields, marked primary. The automation that copies the primary address back to the standard fields then runs on it as on any other address.</description>
    <name>Create_First_Address</name>
    <label>Create first address</label>
    <locationX>176</locationX>
    <locationY>323</locationY>
    <inputAssignments>
      <field>Account__c</field>
      <value>
        <elementReference>$Record.Id</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>City__c</field>
      <value>
        <elementReference>$Record.BillingCity</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Country__c</field>
      <value>
        <elementReference>$Record.BillingCountry</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Is_Default__c</field>
      <value>
        <booleanValue>true</booleanValue>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Postal_Code__c</field>
      <value>
        <elementReference>$Record.BillingPostalCode</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>State__c</field>
      <value>
        <elementReference>$Record.BillingState</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Street__c</field>
      <value>
        <elementReference>$Record.BillingStreet</elementReference>
      </value>
    </inputAssignments>
    <inputAssignments>
      <field>Type__c</field>
      <value>
        <elementReference>fAddressType</elementReference>
      </value>
    </inputAssignments>
    <object>Address__c</object>
    <storeOutputAutomatically>true</storeOutputAutomatically>
  </recordCreates>
  <start>
    <locationX>50</locationX>
    <locationY>0</locationY>
    <connector>
      <targetReference>Create_First_Address</targetReference>
    </connector>
    <filterFormula>AND(OR({!$Record.RecordType.DeveloperName} = "Household", {!$Record.Is_Organization__c}), OR(NOT(ISBLANK({!$Record.BillingStreet})), NOT(ISBLANK({!$Record.BillingCity})), NOT(ISBLANK({!$Record.BillingState})), NOT(ISBLANK({!$Record.BillingPostalCode})), NOT(ISBLANK({!$Record.BillingCountry}))))</filterFormula>
    <object>Account</object>
    <recordTriggerType>Create</recordTriggerType>
    <triggerType>RecordAfterSave</triggerType>
  </start>
  <status>Draft</status>
</Flow>
