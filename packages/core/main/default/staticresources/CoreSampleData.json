  "steps": [
    {
      "object": "Saved_Query__c",
      "records": [
        {
          "Name": "Sample: People in Rochester",
          "Object_Name__c": "Contact",
          "Query_JSON__c": "{\"version\":1,\"object\":\"Contact\",\"fields\":[\"Name\",\"Email\",\"Phone\",\"MailingCity\",\"MailingState\"],\"filter\":{\"version\":1,\"conditions\":[{\"field\":\"MailingCity\",\"operator\":\"equals\",\"value\":\"Rochester\",\"id\":1}]},\"orderBy\":[{\"field\":\"LastName\",\"direction\":\"ASC\"}],\"limit\":200}",
          "Sample_Data__c": true
        },
        {
          "Name": "Sample: People Born Before 1960",
          "Object_Name__c": "Contact",
          "Query_JSON__c": "{\"version\":1,\"object\":\"Contact\",\"fields\":[\"Name\",\"Birthdate\",\"Email\",\"MailingCity\"],\"filter\":{\"version\":1,\"conditions\":[{\"field\":\"Birthdate\",\"operator\":\"less than\",\"value\":\"1960-01-01\",\"id\":1}]},\"orderBy\":[{\"field\":\"Birthdate\",\"direction\":\"ASC\"}],\"limit\":200}",
          "Sample_Data__c": true
        },
        {
          "Name": "Sample: Organizations Backup",
          "Object_Name__c": "Account",
          "Query_JSON__c": "{\"version\":1,\"object\":\"Account\",\"fields\":[\"Name\",\"Website\",\"Phone\",\"BillingCity\"],\"filter\":{\"version\":1,\"conditions\":[{\"field\":\"Website\",\"operator\":\"is not null\",\"id\":1}]},\"orderBy\":[{\"field\":\"Name\",\"direction\":\"ASC\"}],\"limit\":200,\"backup\":{\"version\":1}}",
          "Sample_Data__c": true
        }
      ]
