<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <label>Keep brand assignments unique</label>
  <protected>true</protected>
  <values>
    <field>Description__c</field>
    <value xsi:type="xsd:string">Sets each brand assignment's key so a record is assigned to a brand once, keeps one primary brand per person, organization or user, and refreshes brand visibility while it is on. Switch this off and duplicate assignments and two primary brands can be saved, and visibility is not refreshed until the next brand change.</value>
  </values>
  <values>
    <field>Enabled_By_Default__c</field>
    <value xsi:type="xsd:boolean">true</value>
  </values>
  <values>
    <field>Handler_Class__c</field>
    <value xsi:type="xsd:string">BrandTriggerHandler</value>
  </values>
  <values>
    <field>Object_Name__c</field>
    <value xsi:type="xsd:string">Brand_Assignment__c</value>
  </values>
  <values>
    <field>Execution_Order__c</field>
    <value xsi:type="xsd:double">10</value>
  </values>
</CustomMetadata>
