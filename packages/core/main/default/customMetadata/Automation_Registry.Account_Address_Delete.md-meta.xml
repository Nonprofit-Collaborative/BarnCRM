<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Addresses of a deleted account</label>
    <protected>true</protected>
    <values>
        <field>Description__c</field>
        <value xsi:type="xsd:string">When a household, organization or person account is deleted, deletes its addresses with it, and the addresses of the people deleted with a household, or keeps them, as the Addresses of deleted records setting says, and restores them when it is restored. A merge keeps them on the record that stays.</value>
    </values>
    <values>
        <field>Enabled_By_Default__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Handler_Class__c</field>
        <value xsi:type="xsd:string">AddressDeleteHandler</value>
    </values>
    <values>
        <field>Object_Name__c</field>
        <value xsi:type="xsd:string">Account</value>
    </values>
    <values>
        <field>Execution_Order__c</field>
        <value xsi:type="xsd:double">25</value>
    </values>
</CustomMetadata>
