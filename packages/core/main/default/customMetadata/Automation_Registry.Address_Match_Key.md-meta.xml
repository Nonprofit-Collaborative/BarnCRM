<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Address match key</label>
    <protected>true</protected>
    <values>
        <field>Description__c</field>
        <value xsi:type="xsd:string">Keeps each address's Match Key in step with its street and postal code, so duplicate matching finds addresses through an index. It always runs: a key left stale would hide a duplicate.</value>
    </values>
    <values>
        <field>Enabled_By_Default__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Always_Runs__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Handler_Class__c</field>
        <value xsi:type="xsd:string">AddressMatchKeyHandler</value>
    </values>
    <values>
        <field>Object_Name__c</field>
        <value xsi:type="xsd:string">Address__c</value>
    </values>
    <values>
        <field>Execution_Order__c</field>
        <value xsi:type="xsd:double">5</value>
    </values>
</CustomMetadata>
