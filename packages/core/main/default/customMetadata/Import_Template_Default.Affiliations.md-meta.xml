    >{"version": 1, "columns": [{"source": "Person Email", "target": "Record.Contact__c", "lookupField": "Email"}, {"source": "Organization Name", "target": "Record.Organization__c", "lookupField": "Name"}, {"source": "Role", "target": "Record.Role__c"}, {"source": "Is Primary", "target": "Record.Is_Primary__c"}, {"source": "Start Date", "target": "Record.Start_Date__c"}, {"source": "End Date", "target": "Record.End_Date__c"}, {"source": "Description", "target": "Record.Description__c"}]}</value>
