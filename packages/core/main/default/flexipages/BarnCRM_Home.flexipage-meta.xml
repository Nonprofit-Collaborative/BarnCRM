<?xml version="1.0" encoding="UTF-8" ?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
  <description>
    The BarnCRM home page. Each tile is its own component, so an administrator can move, remove
    or add tiles in the App Builder. What's new shows first; setup tiles need Manage BarnCRM
    Settings.
  </description>
  <flexiPageRegions>
    <itemInstances>
      <componentInstance>
        <componentName>firstRunSetup</componentName>
        <identifier>firstRunSetup1</identifier>
      </componentInstance>
    </itemInstances>
    <itemInstances>
      <componentInstance>
        <componentName>whatsNew</componentName>
        <identifier>whatsNew1</identifier>
      </componentInstance>
    </itemInstances>
    <itemInstances>
      <componentInstance>
        <componentName>hubWelcome</componentName>
        <identifier>hubWelcome1</identifier>
      </componentInstance>
    </itemInstances>
    <name>region1</name>
    <type>Region</type>
  </flexiPageRegions>
  <flexiPageRegions>
    <itemInstances>
      <componentInstance>
        <componentInstanceProperties>
          <name>placement</name>
          <value>Top</value>
        </componentInstanceProperties>
        <componentName>hubSetup</componentName>
        <identifier>hubSetupTop</identifier>
        <visibilityRule>
          <criteria>
            <leftValue>{!$Permission.CustomPermission.Manage_BarnCRM_Settings}</leftValue>
            <operator>EQUAL</operator>
            <rightValue>true</rightValue>
          </criteria>
        </visibilityRule>
      </componentInstance>
    </itemInstances>
    <itemInstances>
      <componentInstance>
        <componentName>hubErrors</componentName>
        <identifier>hubErrors1</identifier>
        <visibilityRule>
          <criteria>
            <leftValue>{!$Permission.CustomPermission.Manage_BarnCRM_Settings}</leftValue>
            <operator>EQUAL</operator>
            <rightValue>true</rightValue>
          </criteria>
        </visibilityRule>
      </componentInstance>
    </itemInstances>
    <itemInstances>
      <componentInstance>
        <componentName>hubRollups</componentName>
        <identifier>hubRollups1</identifier>
        <visibilityRule>
          <criteria>
            <leftValue>{!$Permission.CustomPermission.Manage_BarnCRM_Settings}</leftValue>
            <operator>EQUAL</operator>
            <rightValue>true</rightValue>
          </criteria>
        </visibilityRule>
      </componentInstance>
    </itemInstances>
    <itemInstances>
      <componentInstance>
        <componentName>hubSeasonalAddresses</componentName>
        <identifier>hubSeasonalAddresses1</identifier>
        <visibilityRule>
          <criteria>
            <leftValue>{!$Permission.CustomPermission.Manage_BarnCRM_Settings}</leftValue>
            <operator>EQUAL</operator>
            <rightValue>true</rightValue>
          </criteria>
        </visibilityRule>
      </componentInstance>
    </itemInstances>
    <itemInstances>
      <componentInstance>
        <componentName>hubModules</componentName>
        <identifier>hubModules1</identifier>
        <visibilityRule>
          <criteria>
            <leftValue>{!$Permission.CustomPermission.Manage_BarnCRM_Settings}</leftValue>
            <operator>EQUAL</operator>
            <rightValue>true</rightValue>
          </criteria>
        </visibilityRule>
      </componentInstance>
    </itemInstances>
    <itemInstances>
      <componentInstance>
        <componentName>hubRecurringFiles</componentName>
        <identifier>hubRecurringFiles1</identifier>
      </componentInstance>
    </itemInstances>
    <itemInstances>
      <componentInstance>
        <componentName>hubQuickLinks</componentName>
        <identifier>hubQuickLinks1</identifier>
      </componentInstance>
    </itemInstances>
    <name>region2</name>
    <type>Region</type>
  </flexiPageRegions>
  <flexiPageRegions>
    <itemInstances>
      <componentInstance>
        <componentName>hubSetup</componentName>
        <identifier>hubSetup1</identifier>
        <visibilityRule>
          <criteria>
            <leftValue>{!$Permission.CustomPermission.Manage_BarnCRM_Settings}</leftValue>
            <operator>EQUAL</operator>
            <rightValue>true</rightValue>
          </criteria>
        </visibilityRule>
      </componentInstance>
    </itemInstances>
    <itemInstances>
      <componentInstance>
        <componentInstanceProperties>
          <name>lastResultFirst</name>
          <value>true</value>
        </componentInstanceProperties>
        <componentName>healthCheckPanel</componentName>
        <identifier>healthCheckPanel1</identifier>
        <visibilityRule>
          <criteria>
            <leftValue>{!$Permission.CustomPermission.Manage_BarnCRM_Settings}</leftValue>
            <operator>EQUAL</operator>
            <rightValue>true</rightValue>
          </criteria>
        </visibilityRule>
      </componentInstance>
    </itemInstances>
    <name>region3</name>
    <type>Region</type>
  </flexiPageRegions>
  <masterLabel>BarnCRM Home</masterLabel>
  <template>
    <name>flexipage:appHomeTemplateHeaderTwoColumnsLeftSidebar</name>
  </template>
  <type>AppPage</type>
</FlexiPage>
