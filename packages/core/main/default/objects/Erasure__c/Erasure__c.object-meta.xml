<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
  <deploymentStatus>Deployed</deploymentStatus>
  <description>
    The record that a person was erased at their request: who erased them, when, under which
    request, and each record that changed, never an erased value (canonical model Section 29H).
    Written by BarnCRM only; no packaged permission set may edit or delete it.
  </description>
  <enableActivities>false</enableActivities>
  <enableBulkApi>true</enableBulkApi>
  <enableFeeds>false</enableFeeds>
  <enableHistory>false</enableHistory>
  <enableReports>true</enableReports>
  <enableSearch>false</enableSearch>
  <enableSharing>true</enableSharing>
  <enableStreamingApi>true</enableStreamingApi>
  <label>Erasure</label>
  <nameField>
    <displayFormat>ER-{000000}</displayFormat>
    <label>Erasure Number</label>
    <type>AutoNumber</type>
  </nameField>
  <pluralLabel>Erasures</pluralLabel>
  <sharingModel>Read</sharingModel>
  <visibility>Public</visibility>
</CustomObject>
