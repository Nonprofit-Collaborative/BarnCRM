<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mode__c</fullName>
    <description>When the number is recalculated: in the transaction that changed a record, in the nightly batch, or both.</description>
    <externalId>false</externalId>
    <inlineHelpText>Instantly updates the number as records are saved (a bulk change within minutes). Every night updates it in the nightly run. Both does the first and checks it again every night.</inlineHelpText>
    <label>Mode</label>
    <required>false</required>
    <trackHistory>true</trackHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Real-time</fullName>
                <default>false</default>
                <label>Instantly</label>
            </value>
            <value>
                <fullName>Scheduled</fullName>
                <default>false</default>
                <label>Every night</label>
            </value>
            <value>
                <fullName>Both</fullName>
                <default>true</default>
                <label>Both (recommended)</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
