  <label>Lookup Not Found</label>
  <required>false</required>
  <trackTrending>false</trackTrending>
  <type>Picklist</type>
  <valueSet>
    <restricted>true</restricted>
    <valueSetDefinition>
      <sorted>false</sorted>
      <value>
        <fullName>Reject the row</fullName>
        <default>true</default>
        <label>Reject the row</label>
      </value>
      <value>
        <fullName>Leave it empty</fullName>
        <default>false</default>
        <label>Leave it empty</label>
      </value>
    </valueSetDefinition>
  </valueSet>
</CustomField>
