<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
  <deploymentStatus>Deployed</deploymentStatus>
  <description>
    One count of how many records hold a value in one field, for one object and record type, saved
    from the Field Utilization tab (canonical model Section 29F). Rows are never edited and are kept
    until deleted. Report on it to chart fill rates over time.
  </description>
  <enableActivities>false</enableActivities>
  <enableBulkApi>true</enableBulkApi>
  <enableFeeds>false</enableFeeds>
  <enableHistory>false</enableHistory>
  <enableReports>true</enableReports>
  <enableSearch>false</enableSearch>
  <enableSharing>true</enableSharing>
  <enableStreamingApi>true</enableStreamingApi>
  <label>Field Utilization Snapshot</label>
  <nameField>
    <displayFormat>FUS-{000000}</displayFormat>
    <label>Field Utilization Snapshot Number</label>
    <type>AutoNumber</type>
  </nameField>
  <pluralLabel>Field Utilization Snapshots</pluralLabel>
  <sharingModel>Read</sharingModel>
  <visibility>Public</visibility>
</CustomObject>
