<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Fiscal_Month_In_Range</fullName>
  <active>true</active>
  <description>Canonical model 29BR1: a fiscal year start month is 1 to 12, or blank.</description>
  <errorConditionFormula>NOT(ISBLANK(Fiscal_Year_Start_Month__c)) &amp;&amp; (Fiscal_Year_Start_Month__c &lt; 1 || Fiscal_Year_Start_Month__c &gt; 12)</errorConditionFormula>
  <errorDisplayField>Fiscal_Year_Start_Month__c</errorDisplayField>
  <errorMessage>Enter a month from 1 to 12, or leave it blank.</errorMessage>
</ValidationRule>
