{
  "orgName": "BarnCRM Nonprofit Cloud",
  "edition": "Enterprise",
  "hasSampleData": false,
  "features": [
    "PersonAccounts",
    "ContactsToMultipleAccounts",
    "Fundraising",
    "ProgramManagement",
    "EnableSetPasswordInApi"
  ],
  "settings": {
    "deploymentSettings": {
      "doesSkipAsyncApexValidation": true
    },
    "lightningExperienceSettings": {
      "enableS1DesktopEnabled": true
    },
    "securitySettings": {
      "sessionSettings": {
        "forceRelogin": false
      }
    },
    "accountSettings": {
      "enableRelateContactToMultipleAccounts": true
    },
    "industriesSettings": {
      "enableFundraising": true,
      "enableGiftEntryGrid": true,
      "enableGroupMembershipPref": true,
      "enableBenefitManagementPreference": true
    }
  }
}
